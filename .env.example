# Registry Engine reads these from the shell environment. Nothing loads this
# file automatically: copy it to .env, fill in what you use, then
# `source .env` (or `set -a; . ./.env; set +a`) before `npm start`.
# Every variable is optional.

# AI calls through the Anthropic API on your key (otherwise: your Claude Code login).
export ANTHROPIC_API_KEY=
# Web contact lookup for the top leads through Exa.
export EXA_API_KEY=
# Web contact lookup for the top leads through Parallel (used when EXA_API_KEY is unset).
export PARALLEL_API_KEY=
# Log the AI's raw answer when it can't be used (for diagnosis; it may echo your request).
export REGISTRY_ENGINE_DEBUG=
